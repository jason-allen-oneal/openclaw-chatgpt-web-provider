{
  "id": "chatgpt-web",
  "name": "ChatGPT Web Provider",
  "description": "Browser-backed ChatGPT provider for OpenClaw 2026.8.1 with interactive auth, streaming, and multi-model support",
  "activation": {
    "onStartup": true
  },
  "enabledByDefault": false,
  "providers": [
    "chatgpt-web"
  ],
  "modelSupport": {
    "modelPrefixes": [
      "chatgpt-web/"
    ]
  },
  "modelCatalog": {
    "providers": {
      "chatgpt-web": {
        "baseUrl": "chatgpt-web://local",
        "api": "openai-completions",
        "models": [
          {
            "id": "backup",
            "name": "ChatGPT Web (backup)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 16384
          },
          {
            "id": "auto",
            "name": "ChatGPT Web (Auto)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 16384
          },
          {
            "id": "gpt-4o",
            "name": "ChatGPT Web (GPT-4o)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 16384
          },
          {
            "id": "o3-mini",
            "name": "ChatGPT Web (o3-mini)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 32768
          },
          {
            "id": "gpt-5",
            "name": "ChatGPT Web (GPT-5)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 32768
          }
        ]
      }
    }
  },
  "autoEnableWhenConfiguredProviders": [
    "chatgpt-web"
  ],
  "nonSecretAuthMarkers": [
    "chatgpt-web-local"
  ],
  "syntheticAuthRefs": [
    "chatgpt-web"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "webchatUrl": {
        "type": "string",
        "format": "uri"
      },
      "mode": {
        "type": "string",
        "enum": [
          "launch",
          "cdp"
        ]
      },
      "profileDir": {
        "type": "string"
      },
      "cdpUrl": {
        "type": "string",
        "format": "uri"
      },
      "executablePath": {
        "type": "string"
      },
      "sandboxMode": {
        "type": "string",
        "enum": [
          "default",
          "userns"
        ]
      },
      "headless": {
        "type": "boolean"
      },
      "maxPromptChars": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 300000
      },
      "readyTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 300000
      },
      "responseTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 900000
      },
      "stabilityWindowMs": {
        "type": "integer",
        "minimum": 250,
        "maximum": 30000
      },
      "models": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "name": {
              "type": "string"
            },
            "reasoning": {
              "type": "boolean"
            },
            "webLabel": {
              "type": "string"
            },
            "reasoningOptions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "off": { "type": "string" },
                "minimal": { "type": "string" },
                "low": { "type": "string" },
                "medium": { "type": "string" },
                "high": { "type": "string" },
                "xhigh": { "type": "string" },
                "max": { "type": "string" }
              }
            },
            "contextWindow": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 200000
            },
            "maxTokens": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 32768
            }
          }
        }
      },
      "selectors": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "composer": {
            "type": "string"
          },
          "send": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "assistant": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "responseContent": {
            "type": "string"
          },
          "completion": {
            "type": "string"
          },
          "stop": {
            "type": "string"
          },
          "modelPicker": {
            "type": "string"
          },
          "modelOption": {
            "type": "string"
          },
          "reasoningPicker": {
            "type": "string"
          },
          "reasoningOption": {
            "type": "string"
          }
        }
      }
    }
  }
}
