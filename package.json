{
  "name": "openclaw-chatgpt-web-provider",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-backed ChatGPT fallback provider for OpenClaw 2026.8.1",
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "npm run build && node scripts/check-pack.mjs"
  },
  "dependencies": {
    "playwright-core": "1.61.1"
  },
  "devDependencies": {
    "openclaw": "^2026.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.1",
      "minGatewayVersion": "2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    }
  }
}
